# Сценарий: аппарат закрутило, система ориентации гасит вращение.
# Пороги из limits.cpp: угловая скорость — предупреждение выше 2 °/с,
# авария выше 5 °/с; маховики — предупреждение выше 5000 об/мин.
# Проверяется и качество данных: норма кватерниона обязана быть единицей,
# отклонение означает сбой вычислителя ориентации, а не состояние борта.
# Запуск: python sat_sim.py --scenario scenarios/adcs_tumbling.jsonl --rate 2
{"_note": "ориентация стабильна", "_repeat": 8}
{"_note": "начало закрутки — ПРЕДУПРЕЖДЕНИЕ по угловой скорости", "adcs.gyro": [1.2, -2.8, 0.4], "_repeat": 6}
{"_note": "выше 5 °/с — АВАРИЯ, аппарат кувыркается", "adcs.gyro": [3.1, -7.4, 2.2], "adcs.sun_sensor": [0.0, 0.81, 0.0, 0.0, 0.34, 0.0], "_repeat": 8}
{"_note": "маховики раскручиваются на гашение — предупреждение по оборотам", "adcs.gyro": [2.4, -5.6, 1.8], "adcs.reaction_wheel_speed": [5300.0, -5450.0, 4900.0], "_repeat": 8}
{"_note": "сбой вычислителя: норма кватерниона перестала быть единицей", "adcs.quaternion": [0.42, 0.11, 0.07, 0.03], "adcs.gyro": [1.9, -3.2, 1.1], "obc.last_error_code": 9, "_repeat": 6}
{"_note": "вычислитель перезапущен, кватернион снова нормирован", "adcs.quaternion": [0.981, 0.142, 0.095, 0.058], "adcs.gyro": [0.8, -1.4, 0.5], "obc.reboot_count": 4, "obc.last_error_code": 0, "_repeat": 6}
{"_note": "вращение погашено, маховики сбрасывают обороты", "adcs.gyro": [0.04, -0.02, 0.01], "adcs.reaction_wheel_speed": [1240.0, -1180.0, 1205.0], "_repeat": 10}
